* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  background: #111827;
  font-family: Arial, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  color: white;
  overflow: hidden;
}

.game-wrapper {
  width: min(100%, 500px);
  padding: 10px;
}

.top-bar {
  background: #1f2937;
  padding: 15px;
  border-radius: 15px 15px 0 0;
  text-align: center;
}

.top-bar h1 {
  font-size: 24px;
  margin-bottom: 10px;
}

.stats {
  display: flex;
  justify-content: space-around;
  font-size: 14px;
}

#game {
  position: relative;
  width: 100%;
  height: 650px;
  max-height: 75vh;
  min-height: 450px;
  overflow: hidden;
  background:
    linear-gradient(#172554, #0f172a);
  border-left: 3px solid #334155;
  border-right: 3px solid #334155;
}

/* Player */

#player {
  position: absolute;
  bottom: 25px;
  left: 50%;
  transform: translateX(-50%);
  width: 50px;
  height: 50px;
  font-size: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  user-select: none;
}

/* Objects */

.obstacle,
.coin,
.powerup {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
}

.obstacle {
  width: 45px;
  height: 45px;
  font-size: 35px;
}

.coin {
  width: 35px;
  height: 35px;
  font-size: 28px;
}

.powerup {
  width: 40px;
  height: 40px;
  font-size: 30px;
}

/* Screens */

.screen {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 20px;
  z-index: 20;
}

.screen h2 {
  font-size: 32px;
  margin-bottom: 15px;
}

.screen p {
  margin: 8px 0;
}

.screen strong {
  font-size: 50px;
  margin: 10px;
}

button {
  border: none;
  border-radius: 12px;
  background: #22c55e;
  color: white;
  font-size: 18px;
  font-weight: bold;
  padding: 13px 25px;
  cursor: pointer;
  margin-top: 15px;
}

button:active {
  transform: scale(0.94);
}

.help {
  font-size: 13px;
  opacity: 0.7;
  margin-top: 25px !important;
}

.hidden {
  display: none;
}

/* Mobile controls */

.controls {
  display: flex;
  gap: 20px;
  justify-content: center;
  background: #1f2937;
  padding: 12px;
  border-radius: 0 0 15px 15px;
}

.controls button {
  width: 120px;
  height: 55px;
  margin: 0;
  font-size: 25px;
  background: #374151;
}

#powerupMessage {
  position: absolute;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(34, 197, 94, 0.9);
  padding: 10px 18px;
  border-radius: 20px;
  font-weight: bold;
  display: none;
  z-index: 15;
}
